<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FaceBlood_WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FaceBlood_WinUI3"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="FaceBlood.WinUI3"
    mc:Ignorable="d">
    <!--
        Keep the window shell minimal to avoid runtime COM activation issues
        on machines where newer windowing components are unavailable.
    -->
    <Frame x:Name="RootFrame" />
</Window>
